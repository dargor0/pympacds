#!/usr/bin/make -f
export DH_VERBOSE=1

export PYBUILD_NAME=pympacds_gpio
export PYBUILD_DISABLE=test
export PYBUILD_SYSTEM=pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_installsystemd:
	dh_installsystemd --name=pympacds-gpio

override_dh_builddeb:
	# Force gzip compression for constrained embedded distributions.
	dh_builddeb -- -Zgzip
