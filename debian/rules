#!/usr/bin/make -f
export DH_VERBOSE=1

export PYBUILD_NAME=pympacds
export PYBUILD_DISABLE=test
export PYBUILD_SYSTEM=pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_installman:
	PYMPACDS_MAN_BUILD=1 sphinx-build -E -b man doc debian/man-build
	dh_installman debian/man-build/pympacds-admin.1

override_dh_clean:
	dh_clean
	rm -rf debian/man-build

override_dh_builddeb:
	# override for embedded linux distributions: some debian/ubuntu based
	# distributions doesn't support default xz compression, it is better
	# to force old gzip compression to avoid problems with constrained
	# platforms.
	dh_builddeb -- -Zgzip
